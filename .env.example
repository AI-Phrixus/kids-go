# Kids Igo — copy to .env / wrangler secrets. NEVER commit real keys.

# --- Coach AI (optional; default is offline static phrases) ---
# none | openai_compatible | xai | google
COACH_PROVIDER=none

# Universal OpenAI-compatible endpoint (xAI, OpenRouter, Groq, free promos, etc.)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# xAI shortcut (optional)
# XAI_API_KEY=
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-4.5

# Google Gemini (optional; good for free/promo tiers)
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

COACH_TIMEOUT_MS=2500
COACH_MAX_TOKENS=120
COACH_TEMPERATURE=0.5

# --- App ---
# SESSION_SECRET=generate-a-long-random-string
