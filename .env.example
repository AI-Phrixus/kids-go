# Kids Igo — never commit real keys.

# --- Coach chain (recommended) ---
# auto = Cloudflare Workers AI free → your BYOK third-party → static phrases
COACH_PROVIDER=auto
COACH_CHAIN_MODE=cf_first

# Soft max successful Workers AI coach calls per UTC day (default 40).
# Free plan hard wall ~10_000 Neurons/day — soft cap switches early to avoid hitting the wall mid-game.
# IMPORTANT: Stay on **Workers Free** so Workers AI hard-stops instead of billing overage.
COACH_CF_SOFT_MAX_CALLS=40
COACH_CF_MODEL=@cf/meta/llama-3.1-8b-instruct

COACH_TIMEOUT_MS=2500
COACH_MAX_TOKENS=120
COACH_TEMPERATURE=0.5

# --- BYOK fallback when CF free quota / soft cap is hit ---
# Prefer non–red-supply-chain providers (see docs/COACH-PROVIDERS.md)

# Option A: xAI Grok (US)
# XAI_API_KEY=
# (or set COACH_PROVIDER=xai)

# Option B: Google Gemini free tier (US)
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# Option C: OpenAI-compatible (Groq free, OpenRouter free models, etc. — check region/owner)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.1-8b-instant

# SESSION_SECRET=
