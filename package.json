{
  "name": "kids-go",
  "version": "0.1.0",
  "private": true,
  "description": "Kids Igo — children's Go learning game (Cloudflare Free)",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:api": "wrangler dev",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "deploy": "npm run build:web && wrangler deploy",
    "db:local": "wrangler d1 migrations apply kids-go --local",
    "db:remote": "wrangler d1 migrations apply kids-go --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "4.24.0"
  },
  "dependencies": {
    "hono": "^4.8.4"
  }
}
